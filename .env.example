# AWS config
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=

# Lambda config
AWS_LAMBDA_REGION=

# DynamoDB config
AWS_DB_REGION=
AWS_DB_TABLE_NAME=

# EventBridge config
AWS_EVENTBRIDGE_RULE_NAME=

# OpenAI-compatible API key
AI_API_KEY=

# Daily update schedule, HHMM UTC (0000-2359)
# - The update function runs SCHEDULE_BUFFER minutes before each time listed in
#   SCHEDULE to ensure smooth updates
# - The schedule must be expressible in a single cron expression (i.e., the
#   Cartesian product of all unique hours and minutes within the schedule should
#   match the schedule itself)
# - Example: if SCHEDULE=[1300,2100] and SCHEDULE_BUFFER=15, the actual function
#   will start up at around 12:45 and 20:45 UTC daily, while the web app will
#   update at around 13:00 and 21:00 UTC daily
SCHEDULE=[1300,2100]
SCHEDULE_BUFFER=15
